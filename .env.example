# Which AI provider powers chat, intent routing, and (where supported)
# embeddings. One of: gemini, openai, claude
AI_PROVIDER=gemini

# Optional — override the default model for your chosen provider.
# Defaults: gemini -> gemini-3.1-flash-lite, openai -> gpt-4o-mini,
# claude -> claude-sonnet-4-6
AI_MODEL=

# Telegram bot token from @BotFather — required
TELEGRAM_BOT_TOKEN=

# --- AI provider API keys — only fill in the one matching AI_PROVIDER ---

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
# Note: Claude has no embeddings API, so semantic memory search is
# automatically disabled while AI_PROVIDER=claude.
ANTHROPIC_API_KEY=

# --- Local / self-hosted LLM (OpenAI-compatible: Ollama, LM Studio, vLLM) -----
# Run the chat model on your own machine instead of a cloud API. Set:
#   AI_PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama's OpenAI-compatible API
#   OPENAI_API_KEY=ollama                        # any dummy string; local servers ignore it
#   AI_MODEL=qwen2.5:7b-instruct                 # a model you've `ollama pull`ed
# Semantic memory stays OFF on a local server unless you also point it at an
# embedding model that outputs 768 dims (to match supabase_schema.sql):
#   OPENAI_EMBED_MODEL=nomic-embed-text
# Voice transcription needs Whisper, which Ollama has no endpoint for — voice
# notes fall back gracefully while running fully local (see README).
OPENAI_BASE_URL=
OPENAI_EMBED_MODEL=

# Local voice transcription (Whisper). Set to a faster-whisper model size to
# transcribe voice notes on-box, independent of the chat provider — e.g. "base"
# (fast) or "small" (better). Requires: pip install faster-whisper. Leave blank
# to disable (voice then relies on an audio-capable cloud provider, if any).
WHISPER_MODEL=

# Supabase project URL and service/anon key — required for chat logging,
# semantic memory, and live polls (https://supabase.com)
SUPABASE_URL=
SUPABASE_KEY=

# Tavily API key — optional, enables live web search (https://tavily.com)
TAVILY_API_KEY=

# Alpha Vantage API key — optional, enables stock/forex/commodity quotes
# (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_KEY=
