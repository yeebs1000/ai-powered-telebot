# ── Provider ──────────────────────────────────────────────────────────────────
# One of: openai · gemini · claude · deepseek · openrouter · groq · together · local
# Full guide, including model assignment: docs/PROVIDERS.md
AI_PROVIDER=local

# Model. Routers (openrouter/groq/together) and `local` have no default —
# set this, or the bot tells you to at startup.
#   openrouter → AI_MODEL=anthropic/claude-sonnet-4.5
#   deepseek   → AI_MODEL=deepseek-chat
#   local      → AI_MODEL=qwen3.5:9b
AI_MODEL=

# Optional per-role overrides. AI_MODEL is the base default for every role;
# these override one role each. The router makes a short strict-JSON call once
# per message — a small fast model does it just as well and costs far less.
# AI_MODEL_CHAT=
# AI_MODEL_ROUTER=

# ── Provider keys — fill in only the one matching AI_PROVIDER ─────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Any OpenAI-compatible server (Ollama, LM Studio, vLLM). Required for
# AI_PROVIDER=local; also overrides a preset's base URL if you proxy it.
# Check where your server actually listens — if you set OLLAMA_HOST, loopback
# is not it.
OPENAI_BASE_URL=

# Reasoning models spend most of their output on thinking that is discarded:
# measured 1686 tokens / 118s with it on, 68 tokens / 5.8s with it off. Set
# this to `none` for a reasoning model. Leave blank for cloud OpenAI.
OPENAI_REASONING_EFFORT=

# ── Embeddings (semantic memory) ──────────────────────────────────────────────
# Routers serve chat completions, not embeddings, so semantic memory would
# switch itself off. Point embeddings at something that does serve them — a
# local Ollama costs nothing:
#   EMBED_BASE_URL=http://localhost:11434/v1
#   EMBED_MODEL=nomic-embed-text      (768-dim)
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=

# ── Telegram ──────────────────────────────────────────────────────────────────
# From @BotFather. To let it read group messages:
#   /setprivacy → your bot → Disable
TELEGRAM_BOT_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────────
# Local SQLite file — chat history, embeddings, members, polls. Created on
# first run; no database to provision.
TELEBOT_DB=

# ── Optional extras ───────────────────────────────────────────────────────────
# Live web search (https://tavily.com)
TAVILY_API_KEY=

# Local voice transcription — a faster-whisper size such as "base" or "small".
# Requires: pip install faster-whisper. Blank disables voice.
WHISPER_MODEL=

# Read-only reference folder the bot may quote from when replying. Blank
# disables it. Anything in here can be repeated to everyone in the group.
VAULT_REF_ROOT=
