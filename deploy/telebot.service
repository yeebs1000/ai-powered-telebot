# AI-Powered Telebot -- yeebo-SER8 deployment.
#
# Telegram long-polling: this service opens NO listening socket. It dials out
# to api.telegram.org and to Ollama on the docker bridge. The listener audit
# (runbook §3) must show nothing new after enabling it.
#
# Install:
#   sudo cp /opt/telebot/deploy/telebot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now telebot.service
#   journalctl -u telebot -f
#
# IMPORTANT: exactly ONE poller per bot token, anywhere. If the Railway
# instance is still up, Telegram returns 409 Conflict and both misbehave.

[Unit]
Description=AI-Powered Telebot (Telegram long-poll, local Ollama backend)
Documentation=file:///opt/telebot/README.md
After=network-online.target ollama.service docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=telebot
Group=telebot
WorkingDirectory=/opt/telebot
SyslogIdentifier=telebot
Restart=on-failure
RestartSec=10

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# telebot has no real home; give it a writable state dir instead.
Environment=HOME=/var/lib/telebot
StateDirectory=telebot
# Pinned explicitly. The code default is relative (so a plain clone
# runs anywhere); a deployment must not inherit that and silently
# start a fresh database in WorkingDirectory.
Environment=TELEBOT_DB=/var/lib/telebot/telebot.db

# --- Model backend: local Ollama, OpenAI-compatible lane -------------------
# NOT localhost:11434. Ollama binds the docker bridge on this box
# (OLLAMA_HOST=172.17.0.1:11434, set in its systemd override) so containers can
# reach it; loopback has nothing listening. ufw allows 11434 in on docker0.
Environment=AI_PROVIDER=openai
Environment=OPENAI_BASE_URL=http://172.17.0.1:11434/v1
Environment=AI_MODEL=qwen3.5-agent:32k
# qwen3.5-agent is a reasoning model: a 127-char reply cost 1686 tokens
# and ~118s with thinking on, versus 68 tokens and ~6s with it off. The
# router makes a second call per message, so this is the whole latency
# budget. Unset it if the chat model is ever a non-reasoning one.
Environment=OPENAI_REASONING_EFFORT=none
# Semantic memory: nomic-embed-text, verified 768-dim on this box, matching
# the vector width the schema was written for.
Environment=OPENAI_EMBED_MODEL=nomic-embed-text
# Voice STT stays OFF: faster-whisper is not installed and would add RAM load.
#Environment=WHISPER_MODEL=base

# --- Vault reference (read-only, one folder) ------------------------------
# Spaceless symlink, as with the projector: BindPaths does not honour \x20.
# ReadOnly, and scoped to "13 AI/Telegram/Reference" ALONE -- the bot cannot
# traverse the vault, so nothing else in it can reach a group chat this way.
Environment=VAULT_REF_ROOT=/var/lib/telebot/vault-ref
BindReadOnlyPaths=/etc/yeebs/obsidian-binds/telegram-ref:/var/lib/telebot/vault-ref

# --- Credentials -----------------------------------------------------------
# One secret per file in /etc/yeebs/secrets/telebot, injected as env vars named
# after each file. Nothing lands in a .env, a log, or shell history. The helper
# exits 77 if a secret exists but cannot be read -- it will not start degraded.
ExecStart=/usr/local/sbin/yeebs-run-with-secrets /etc/yeebs/secrets/telebot \
    /opt/telebot/.venv/bin/python main.py

# --- Hardening -------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
